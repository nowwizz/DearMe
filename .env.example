# Copy to .env and fill in credentials only on your machine.
TOUR_API_KEY=
TMAP_APP_KEY=
GMS_KEY=
# The Responses client appends /responses to this base URL.
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_MODEL=gpt-6.1-sol
MAX_REPLANS=3
LOGGING_ENABLED=true
# Public JavaScript key from Kakao Developers, used for invitation sharing.
KAKAO_JS_KEY=
